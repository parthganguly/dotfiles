#!/bin/bash

if [ ! -p /tmp/eww-cava ]; then
    echo "▁ ▁ ▁ ▁ ▁ ▁ ▁ ▁ ▁ ▁ ▁ ▁"
    exit 0
fi

RAW=$(timeout 0.08s dd bs=1 count=12 if=/tmp/eww-cava 2>/dev/null)

if [ -z "$RAW" ]; then
    echo "▁ ▁ ▁ ▁ ▁ ▁ ▁ ▁ ▁ ▁ ▁ ▁"
    exit 0
fi

OUT=""

for (( i=0; i<${#RAW}; i++ )); do
    C="${RAW:$i:1}"

    case "$C" in
        0) OUT="${OUT}▁ " ;;
        1) OUT="${OUT}▂ " ;;
        2) OUT="${OUT}▃ " ;;
        3) OUT="${OUT}▄ " ;;
        4) OUT="${OUT}▅ " ;;
        5) OUT="${OUT}▆ " ;;
        6) OUT="${OUT}▇ " ;;
        7) OUT="${OUT}█ " ;;
        *) OUT="${OUT}▁ " ;;
    esac
done

echo "$OUT"	
